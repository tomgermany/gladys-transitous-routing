
{
  "manifest_version": 1,
  "type": "provider",
  "name": "Transitous Fahrplanauskunft – Test",
  "description": {
    "de": "Testoberfläche für Fahrplanauskünfte mit Transitous."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/tomgermany/gladys-transitous-routing:1.0.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/tomgermany/gladys-transitous-routing/main/cover.png",
  "categories": [
    "services"
  ],
  "transports": [
    "cloud"
  ],
  "location": true,
  "widgets": [
    {
      "key": "transitous_departures",
      "label": {
        "de": "Transitous-Fahrplanauskunft – Test"
      },
      "description": {
        "de": "Formular zur Fahrplanauskunft testen und Beispielverbindungen anzeigen."
      },
      "icon": "map-pin",
      "settings": [
        {
          "key": "house",
          "type": "select",
          "source": "houses",
          "label": {
            "de": "Gladys-Zuhause (optional)"
          }
        },
        {
          "key": "latitude",
          "type": "number",
          "label": {
            "de": "Breitengrad"
          },
          "placeholder": {
            "de": "z. B. 49.350"
          },
          "required": false,
          "min": -90,
          "max": 90
        },
        {
          "key": "longitude",
          "type": "number",
          "label": {
            "de": "Längengrad"
          },
          "placeholder": {
            "de": "z. B. 8.690"
          },
          "required": false,
          "min": -180,
          "max": 180
        },
        {
          "key": "contact",
          "type": "string",
          "label": {
            "de": "Transitous-Kennzeichner oder Kontakt"
          },
          "placeholder": {
            "de": "z. B. E-Mail oder Website"
          },
          "required": true
        }
      ]
    }
  ]
}
