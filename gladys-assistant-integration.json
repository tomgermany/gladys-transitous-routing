{
  "manifest_version": 1,
  "type": "provider",
  "name": "Transitous Fahrplanauskunft",
  "description": {
    "en": "Public-transport route search with Transitous.",
    "de": "Fahrplanauskunft für den öffentlichen Verkehr mit Transitous."
  },
  "version": "2.1.3",
  "docker_image": "ghcr.io/tomgermany/gladys-transitous-routing:2.1.3",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/tomgermany/gladys-transitous-routing/main/cover.png",
  "categories": [
    "services"
  ],
  "transports": [
    "cloud"
  ],
  "location": true,
  "widgets": [
    {
      "key": "transitous_routing",
      "label": {
        "en": "Transitous Routing",
        "de": "Transitous Fahrplanauskunft"
      },
      "description": {
        "en": "Search for public-transport routes and view connections.",
        "de": "Verbindungen im öffentlichen Verkehr suchen und anzeigen."
      },
      "icon": "map-pin",
      "settings": [
        {
          "key": "house",
          "type": "select",
          "source": "houses",
          "label": {
            "en": "Gladys home (optional)",
            "de": "Gladys-Zuhause (optional)"
          }
        },
        {
          "key": "latitude",
          "type": "number",
          "label": {
            "en": "Latitude",
            "de": "Breitengrad"
          },
          "placeholder": {
            "en": "e.g. 49.350",
            "de": "z. B. 49.350"
          },
          "required": false,
          "min": -90,
          "max": 90
        },
        {
          "key": "longitude",
          "type": "number",
          "label": {
            "en": "Longitude",
            "de": "Längengrad"
          },
          "placeholder": {
            "en": "e.g. 8.690",
            "de": "z. B. 8.690"
          },
          "required": false,
          "min": -180,
          "max": 180
        },
        {
          "key": "contact",
          "type": "string",
          "label": {
            "en": "Transitous identifier or contact",
            "de": "Transitous-Kennzeichner oder Kontakt"
          },
          "placeholder": {
            "en": "e.g. email or website",
            "de": "z. B. E-Mail oder Website"
          },
          "required": true
        }
      ]
    }
  ]
}
